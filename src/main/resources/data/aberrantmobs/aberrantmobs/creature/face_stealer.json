{
  "model": "aberrantmobs:face_stealer",
  "scale": 0.0625,
  "rig": {
    "head": "head",
    "chain": ["s01", "s02", "s03", "s04", "s05", "s06", "s07", "s08", "s09", "s10", "tail"],
    "legs": ["head_leg", "s01_leg", "s02_leg", "s03_leg", "s04_leg", "s05_leg", "s06_leg", "s07_leg", "s08_leg", "s09_leg", "s10_leg", "tail_leg1", "tail_leg2"],
    "undulation": {"amplitude": 0.35, "idle_amplitude": 0.10, "wavelength": 5.5, "speed_ref": 0.35, "idle_speed": 0.025, "vertical": 0.15},
    "gait": {"stride_deg": 22, "lift_deg": 12, "cycle_blocks": 1.6, "wave": 2.2, "speed_ref": 0.3},
    "mask": "head_mask"
  },
  "body": {
    "width": 2.5,
    "height": 2.5,
    "eye_height": 1.6,
    "segment": {"width": 2.2, "height": 2.2},
    "weak_spot": {"candidates": ["s02", "s03", "s04", "s05", "s06", "s07", "s08", "s09"], "glow": "*_tergite*"}
  },
  "stats": {
    "health": 84,
    "speed": 0.45
  },
  "habitat": {"y_min": -58, "y_max": 0, "max_light": 0, "weight": 2, "exclusion": 128, "cap": 6},
  "loot": "aberrantmobs:creature/face_stealer",
  "mind": {
    "start": "roam",
    "tunables": {"sight": 64, "eye_cone_deg": 10, "face_cone_deg": 75, "memory": 2400, "flinch_at": 10},
    "modes": {
      "roam": {"select": [
        {"when": "hurt", "then": {"enter": "hunt"}},
        {"when": "target.seen && target.distance < 64 && target.underground", "then": {"enter": "stalk"}},
        {"when": "heard.any", "then": {"enter": "prowl"}},
        {"act": "wander", "dig": true}]},
      "prowl": {"select": [
        {"when": "hurt", "then": {"enter": "hunt"}},
        {"when": "target.seen && target.underground", "then": {"enter": "stalk"}},
        {"when": "!heard.any || heard.age > 2400", "then": {"enter": "roam"}},
        {"act": "approach", "target": "heard.bearing", "quiet": true, "dig": true}]},
      "stalk": {"select": [
        {"when": "grab.held || hurt || target.eye_contact", "then": {"enter": "hunt"}},
        {"when": "!target.known", "then": {"wait": "patience", "ticks": 1200, "then": {"enter": "roam"}}},
        {"when": "target.in_sight && blocked", "then": {"enter": "hunt"}},
        {"when": "target.in_sight", "then": {"wait": "watched", "ticks": 200, "then": {"enter": "hunt"}}},
        {"when": "target.in_sight && target.distance > 6", "then": {"act": "climb", "away_from": "target.look"}},
        {"when": "target.distance < 4 && !target.in_sight", "then": {"act": "grab"}},
        {"act": "approach", "target": "target.last_pos", "quiet": true, "dig": true}]},
      "hunt": {"select": [
        {"when": "grab.held", "then": {"cooldown": "bite", "ticks": 30, "then": {"act": "bite"}}},
        {"when": "grab.survived", "then": {"sequence": [{"act": "release"}, {"timer": "no_bite", "set": 600}, {"enter": "flee"}]}},
        {"when": "hurt_hard", "then": {"sequence": [{"act": "release"}, {"timer": "fled", "set": 40}, {"enter": "flee"}]}},
        {"when": "timer.pouncing > 0", "then": {"act": "pounce"}},
        {"when": "target.distance < 2.5 && timer.no_bite == 0", "then": {"act": "grab"}},
        {"when": "target.distance < 9 && target.in_sight && !on_wall && !airborne && timer.no_bite == 0 && timer.pounced == 0", "then": {"sequence": [{"timer": "pounced", "set": 80}, {"timer": "pouncing", "set": 18}, {"act": "pounce"}]}},
        {"when": "!target.known", "then": {"wait": "patience", "ticks": 200, "then": {"enter": "stalk"}}},
        {"act": "chase"}]},
      "flee": {"select": [
        {"when": "timer.fled == 0 && !target.in_sight", "then": {"enter": "roam"}},
        {"act": "flee"}]}
    }
  }
}
